#!/bin/sh
# Runs the openmath-lisp CLI from the shaded jar built by `mvn install`.
DIR="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$(ls "$DIR"/target/openmath-lisp-*-cli.jar 2>/dev/null | head -n 1)"
if [ -z "$JAR" ]; then
  echo "build first: cd $DIR && rm -rf target && mvn install" >&2
  exit 1
fi
exec java -jar "$JAR" "$@"
